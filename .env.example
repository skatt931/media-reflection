TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
DB_PATH=./data/media.sqlite
# Окрема БД щоденника (імпорт: npm run journal:import)
JOURNAL_DB_PATH=./data/journal.sqlite
# Щоденник → Obsidian: папка нових .md на сервері (npm run journal:export)
JOURNAL_EXPORT_DIR=./data/journal-export
# Лише на Mac (npm run journal:pull): куди копіювати, за замовчуванням $OBSIDIAN_VAULT_PATH/Journal
JOURNAL_VAULT_DIR=
# Ідеї → Obsidian: папка нових .md на сервері (npm run journal:export)
IDEAS_EXPORT_DIR=./data/ideas-export
# Лише на Mac: куди копіювати ідеї, за замовчуванням <папка щоденника>/Ideas/Inbox
IDEAS_VAULT_DIR=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TIMEZONE=Europe/Prague
OBSIDIAN_VAULT_PATH=
WEEKLY_DIGEST=fri 18:00
MONTHLY_REVIEW=10:00
VOICE_LANGUAGE=uk
# Backup із сервера на цей Mac (лише на Mac): ім'я Tailscale або user@host
BACKUP_HOST=
BACKUP_DIR=~/Backups/media-reflection
BACKUP_REMOTE_DIR=media-reflection
BACKUP_KEEP=12
